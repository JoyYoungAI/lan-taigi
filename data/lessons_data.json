[
  {
    "id": 1,
    "title": "見面問候與日常禮節",
    "title_tl": "Kìnn-bīn Mn̄g-hō kap Ji̍t-siông Lé-tsiat",
    "description": "學習最核心的台語日常見面問候、道謝、道歉與應對禮儀，開口說台語的第一步！",
    "icon": "👋",
    "dialogue": [
      {
        "speaker": "阿明",
        "hz": "阿華，汝好！食飽未？",
        "tl": "A-huâ, lí hó! Tsia̍h-pá--buē?",
        "m": "阿華，你好！吃飽了沒？"
      },
      {
        "speaker": "阿華",
        "hz": "食飽矣！多謝。汝欲去佗位？",
        "tl": "Tsia̍h-pá--ah! To-siā. Lí beh khì tó-uī?",
        "m": "吃飽了！謝謝。你要去哪裡？"
      },
      {
        "speaker": "阿明",
        "hz": "我欲去買物仔。這陣真無閒，再會喔！",
        "tl": "Guá beh khì bé mi̍h-á. Tsit-tsūn tsin bô-îng, tsài-huē--ooh!",
        "m": "我要去買東西。現在很忙，再見喔！"
      },
      {
        "speaker": "阿華",
        "hz": "好，再會！行好行喔。",
        "tl": "Hó, tsài-huē! Kiânn hó kiânn--ooh.",
        "m": "好，再見！路上小心慢走喔。"
      }
    ],
    "culture_tip": "【勞力 vs 多謝】：「多謝 (to-siā)」是普遍的感謝；「勞力 (lóo-la̍t)」則特別用在感謝對方為自己付出勞力、辛苦幫忙（如農忙、搬重物、熱心引路），是非常溫暖的人情味用語。【歹勢 (pháinn-sè)】兼具「不好意思」、「抱歉」和「害羞」三種語境。",
    "vocab_terms": [
      "汝好",
      "食飽未",
      "多謝",
      "勞力",
      "失禮",
      "歹勢",
      "無要緊",
